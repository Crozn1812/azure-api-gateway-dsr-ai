            "type": "string",
            "title": "Partnerid",
            "example": "partner-a"
          },
          "requestedFields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requestedfields",
            "example": [
              "a",
              "b",
              "c"
            ]
          }
        },
        "type": "object",
        "required": [
          "partnerId",
          "requestedFields"
        ],
        "title": "PartnerMatrixApiRequest"
      },
      "PublicDsrRequest": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "createdDate": {
            "type": "string",
            "title": "Createddate"
          },
          "updatedDate": {
            "type": "string",
            "title": "Updateddate"
          },
          "hptOwner": {
            "type": "string",
            "title": "Hptowner"
          },
          "sharedNote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sharednote"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "title",
          "status",
          "createdDate",
          "updatedDate",
          "hptOwner"
        ],
        "title": "PublicDsrRequest"
      },
      "ReferenceDataResponse": {
        "properties": {
          "correlationId": {
            "type": "string",
            "title": "Correlationid"
          },
          "data": {
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "correlationId",
          "data"
        ],
        "title": "ReferenceDataResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
